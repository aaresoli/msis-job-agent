{
  "name": "HOPE - Refresh all sources",
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/Indiana/Indianapolis" },
  "nodes": [
    {
      "id": "schedule-refresh-all",
      "name": "Every four hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 4 }] } }
    },
    {
      "id": "refresh-all",
      "name": "Request full refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.HOPE_INTERNAL_API_URL}}/sources/refresh-all",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.HOPE_INTERNAL_SERVICE_TOKEN}}" }, { "name": "Idempotency-Key", "value": "=refresh-all-{{$now.toISODate()}}-{{$now.hour}}" }, { "name": "X-Request-ID", "value": "={{$execution.id}}" }] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"limit\":1000,\"dry_run\":false}",
        "options": { "timeout": 300000 }
      }
    }
  ],
  "connections": { "Every four hours": { "main": [[{ "node": "Request full refresh", "type": "main", "index": 0 }]] } },
  "pinData": {},
  "versionId": "561b5182-a880-4dca-a421-100000000003"
}
