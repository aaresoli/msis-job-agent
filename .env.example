# --- Persistence ---------------------------------------------------------
# Persistence backend selection is driven by DATABASE_URL.
#
# * Empty                       -> local SQLite at data/hope_job_agent.sqlite3
# * sqlite:///path/to.db        -> local SQLite file
# * sqlite:///:memory:          -> ephemeral SQLite (tests / dry demos)
# * postgresql+psycopg://...    -> shared/production PostgreSQL (pgvector)
#
# DATABASE_URL always wins when set. When it is empty the POSTGRES_* parts
# below are assembled into a postgresql+psycopg:// URL (used by docker compose
# and Alembic), otherwise SQLite is used.
DATABASE_URL=

# Discrete PostgreSQL connection parts (used when DATABASE_URL is empty).
# These match the docker-compose.yml service defaults for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hope_jobs
POSTGRES_USER=hope_user
POSTGRES_PASSWORD=hope_password

# Example full URL for local docker compose Postgres:
# DATABASE_URL=postgresql+psycopg://hope_user:hope_password@localhost:5432/hope_jobs

# --- Embeddings / pgvector ----------------------------------------------
# Dimension of stored job embeddings. MUST match the embedding model output.
# Common values: 384 (MiniLM), 768 (local models), 1024, 1536 (OpenAI).
# Changing this requires a new Alembic migration (the pgvector column is fixed
# per dimension). See README "pgvector" section.
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=none

# --- Secrets (never commit real values) ---------------------------------
OPENAI_API_KEY=
EMAIL_API_KEY=

# --- Sources -------------------------------------------------------------
APPROVED_JOBS_PATH=docs/examples/approved_jobs.sample.json
KSBIT_EXPORT_PATH=data/sample_ksbit_jobs.json
LOG_LEVEL=INFO
ENVIRONMENT=development
