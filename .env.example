# --- Persistence ---------------------------------------------------------
# Persistence backend selection is driven by DATABASE_URL.
#
# * Empty                       -> local SQLite at data/hope_job_agent.sqlite3
# * sqlite:///path/to.db        -> local SQLite file
# * sqlite:///:memory:          -> ephemeral SQLite (tests / dry demos)
# * postgresql+psycopg://...    -> shared/production PostgreSQL (pgvector)
#
# DATABASE_URL always wins when set. When it is empty the POSTGRES_* parts
# below are assembled into a postgresql+psycopg:// URL (used by docker compose
# and Alembic), otherwise SQLite is used.
DATABASE_URL=

# Discrete PostgreSQL connection parts (used when DATABASE_URL is empty).
# These match the docker-compose.yml service defaults for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hope_jobs
POSTGRES_USER=hope_user
POSTGRES_PASSWORD=hope_password
LANGGRAPH_POSTGRES_DB=hope_langgraph
LANGGRAPH_POSTGRES_USER=hope_langgraph
LANGGRAPH_POSTGRES_PASSWORD=development-only-change-me
LANGGRAPH_DATABASE_URL=
PHOENIX_POSTGRES_DB=hope_phoenix
PHOENIX_POSTGRES_USER=hope_phoenix
PHOENIX_POSTGRES_PASSWORD=development-only-change-me

# Example full URL for local docker compose Postgres:
# DATABASE_URL=postgresql+psycopg://hope_user:hope_password@localhost:5432/hope_jobs

# --- Embeddings / pgvector ----------------------------------------------
# Dimension of stored job embeddings. MUST match the embedding model output.
# Common values: 384 (MiniLM), 768 (local models), 1024, 1536 (OpenAI).
# Changing this requires a new Alembic migration (the pgvector column is fixed
# per dimension). See README "pgvector" section.
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=embeddinggemma

# --- Platform and private integrations ----------------------------------
# Every "development-only-change-me" below MUST be replaced before the stack
# is reachable by anyone else. Generate each one independently with:
#
#     openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=[]
AUTH_PEPPER=development-only-change-me
INTERNAL_SERVICE_TOKEN=development-only-change-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hope_minio
MINIO_SECRET_KEY=development-only-change-me
# The compose default points at the dev mailpit container (mailpit:1025). Set
# these for a real relay. They are read by the API *and* the workers: magic
# links come from the API, student digests from the outbox relay on a worker.
SMTP_HOST=
SMTP_PORT=587
# Set to false only for a local mail catcher such as Mailpit, which speaks plain
# SMTP. Against a real relay, leave it true: false sends the sign-in link in the
# clear.
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HOPE Career Intelligence <no-reply@example.edu>

# --- Backups -------------------------------------------------------------
# The nightly task dumps hope_jobs plus cluster roles into this MinIO bucket,
# restores it into a scratch database to verify it, and prunes past the
# retention window. Kept separate from MINIO_BUCKET, which holds student
# resumes and is purged per user by the retention task.
BACKUP_BUCKET=hope-backups
BACKUP_RETENTION_DAYS=30

# Add these later; an empty endpoint keeps local AI safely degraded.
# An empty OLLAMA_CHAT_MODEL selects the disabled provider: the platform still
# runs, with enrichment and match explanations marked degraded.
#
# On the DGX Spark (128GB unified memory) with the "ai" compose profile:
#   OLLAMA_BASE_URL=http://ollama:11434
#   OLLAMA_CHAT_MODEL=gpt-oss:120b        # batch: enrichment, matching, pulse
#   OLLAMA_INTERACTIVE_MODEL=gpt-oss:20b  # the streaming coach
#
# Pick MoE models, not dense ones. The Spark is limited by memory bandwidth
# (~273 GB/s), not capacity, so what matters is *active* parameters per token.
# Measured on this hardware: gpt-oss:120b (5.1B active) runs ~40 tok/s, while
# a dense llama3.3:70b runs ~2.7 tok/s. A dense model is not a "faster, smaller"
# swap for the 120b — it is 15x slower. qwen3:30b-a3b is a good MoE alternative.
#
# OLLAMA_INTERACTIVE_MODEL is optional: leave it empty and the coach uses
# OLLAMA_CHAT_MODEL. If you do set it, raise OLLAMA_MAX_LOADED_MODELS to 3 or
# Ollama evicts one chat model to load the other on every queue switch.
#
# OLLAMA_EMBEDDING_MODEL must stay a 768-dimension model to match
# EMBEDDING_DIMENSION above. A mismatch is now logged and the vector discarded.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
OLLAMA_INTERACTIVE_MODEL=
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Context window sent with every chat call. Ollama silently truncates anything
# longer, and Market Pulse and resume parsing both send ~30k characters (~8k
# tokens), so 16384 leaves real headroom. This is not a free knob: every
# parallel decode slot reserves its own KV cache at this size, so it and
# OLLAMA_NUM_PARALLEL are budgeted together. Measured on the Spark, gpt-oss:120b
# reserved 16GB of KV for one 32768-token slot.
OLLAMA_NUM_CTX=16384
# The coach sends a question plus retrieved context, never a 30k-char payload.
# Its own smaller window is what frees the memory the batch slots spend.
OLLAMA_INTERACTIVE_NUM_CTX=8192
# gpt-oss always reasons; this bounds how much. Empty leaves the model default.
#
# Empty for batch is a measured choice, not an oversight. The reasoning tokens
# ARE discarded on the extraction paths, and setting "low" is the single biggest
# throughput win available -- 17.2s to 9.4s per posting over 40 real postings.
# It also dropped schema acceptance from 36/40 to 33/40, i.e. three more
# postings per forty into a human review queue. Reviewer time is scarcer than
# GPU time on a nightly batch, so quality wins by default. Set it to "low" if
# your corpus says otherwise -- and re-run scripts/evaluate_local_models.py plus
# a real backlog to confirm, because the committed gold set scores 12/12 either
# way and will not show you the difference.
OLLAMA_BATCH_REASONING=
OLLAMA_INTERACTIVE_REASONING=medium
# How many requests the server decodes at once. The Spark is bandwidth-bound, so
# concurrent sequences amortize one weight read across the batch: this is where
# most of the unclaimed throughput on a GB10 lives. Keep it equal to
# OLLAMA_NUM_PARALLEL on the ollama service (the workers size their fan-out from
# it) and drop to 2 if the 120b starts evicting the interactive model.
OLLAMA_NUM_PARALLEL=4
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=2h
OLLAMA_MAX_LOADED_MODELS=3
# Flash attention is a prefill win on long job descriptions and is a
# prerequisite for KV quantization. q8_0 roughly halves KV per slot, which is
# what makes OLLAMA_NUM_PARALLEL=4 fit alongside 65GB of weights.
OLLAMA_FLASH_ATTENTION=true
OLLAMA_KV_CACHE_TYPE=q8_0
OTEL_EXPORTER_OTLP_ENDPOINT=

# Future sources stay disabled without endpoint mapping and written approval.
DENODO_BASE_URL=
DENODO_VIEW_NAME=
APIFY_WEBHOOK_SECRET=
SOURCE_APPROVAL_ID=

# --- Sources -------------------------------------------------------------
APPROVED_JOBS_PATH=docs/examples/approved_jobs.sample.json
KSBIT_EXPORT_PATH=data/sample_ksbit_jobs.json

# Apify LinkedIn source (src/hope_job_agent/sources/apify_linkedin.py).
# APIFY_TOKEN is your personal Apify API token — set it in .env, never commit.
# APIFY_ACTOR_ID accepts either the actor's alphanumeric id or the
# username~actor-name alias shown in the Apify console.
APIFY_TOKEN=
APIFY_ACTOR_ID=cheap_scraper~linkedin-job-scraper
APIFY_MAX_ITEMS=1000

# Apify LinkedIn *posts* source (src/hope_job_agent/sources/apify_linkedin_posts.py).
# Reuses APIFY_TOKEN above. APIFY_POSTS_ACTOR_ID is the LinkedIn posts scraper
# actor (alphanumeric id or username~actor-name alias). Ingests hiring-manager
# posts into market_posts; feed a specific run/dataset with the run_posts CLI flags.
APIFY_POSTS_ACTOR_ID=apimaestro~linkedin-posts-search-scraper
APIFY_POSTS_MAX_ITEMS=500
LOG_LEVEL=INFO
ENVIRONMENT=development
