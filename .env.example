# --- Persistence ---------------------------------------------------------
# Persistence backend selection is driven by DATABASE_URL.
#
# * Empty                       -> local SQLite at data/hope_job_agent.sqlite3
# * sqlite:///path/to.db        -> local SQLite file
# * sqlite:///:memory:          -> ephemeral SQLite (tests / dry demos)
# * postgresql+psycopg://...    -> shared/production PostgreSQL (pgvector)
#
# DATABASE_URL always wins when set. When it is empty the POSTGRES_* parts
# below are assembled into a postgresql+psycopg:// URL (used by docker compose
# and Alembic), otherwise SQLite is used.
DATABASE_URL=

# Discrete PostgreSQL connection parts (used when DATABASE_URL is empty).
# These match the docker-compose.yml service defaults for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hope_jobs
POSTGRES_USER=hope_user
POSTGRES_PASSWORD=hope_password
LANGGRAPH_POSTGRES_DB=hope_langgraph
LANGGRAPH_POSTGRES_USER=hope_langgraph
LANGGRAPH_POSTGRES_PASSWORD=development-only-change-me
LANGGRAPH_DATABASE_URL=
N8N_POSTGRES_DB=hope_n8n
N8N_POSTGRES_USER=hope_n8n
N8N_POSTGRES_PASSWORD=development-only-change-me
PHOENIX_POSTGRES_DB=hope_phoenix
PHOENIX_POSTGRES_USER=hope_phoenix
PHOENIX_POSTGRES_PASSWORD=development-only-change-me

# Example full URL for local docker compose Postgres:
# DATABASE_URL=postgresql+psycopg://hope_user:hope_password@localhost:5432/hope_jobs

# --- Embeddings / pgvector ----------------------------------------------
# Dimension of stored job embeddings. MUST match the embedding model output.
# Common values: 384 (MiniLM), 768 (local models), 1024, 1536 (OpenAI).
# Changing this requires a new Alembic migration (the pgvector column is fixed
# per dimension). See README "pgvector" section.
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=embeddinggemma

# --- Platform and private integrations ----------------------------------
APP_BASE_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=[]
AUTH_PEPPER=development-only-change-me
INTERNAL_SERVICE_TOKEN=development-only-change-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hope_minio
MINIO_SECRET_KEY=development-only-change-me
N8N_ENCRYPTION_KEY=development-only-change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Add these later; an empty endpoint keeps local AI safely degraded.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OTEL_EXPORTER_OTLP_ENDPOINT=

# Future sources stay disabled without endpoint mapping and written approval.
DENODO_BASE_URL=
DENODO_VIEW_NAME=
APIFY_WEBHOOK_SECRET=
SOURCE_APPROVAL_ID=

# --- Sources -------------------------------------------------------------
APPROVED_JOBS_PATH=docs/examples/approved_jobs.sample.json
KSBIT_EXPORT_PATH=data/sample_ksbit_jobs.json
LOG_LEVEL=INFO
ENVIRONMENT=development
