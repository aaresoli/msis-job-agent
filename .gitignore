# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Editors and OS files
.DS_Store
.idea/
.vscode/

# Build artifacts
build/
dist/
web/.next/
web/node_modules/
web/playwright-report/
web/test-results/
web/tsconfig.tsbuildinfo

# Local data and logs
data/*
!data/.gitkeep
!data/sample_jobs.json
!data/sample_profiles.json
!data/sample_ksbit_jobs.csv
!data/sample_ksbit_jobs.json
!data/gold_job_postings_labeled.json
!data/data_quality_thresholds.json
# Checked-in configuration and fixtures the tests treat as present. Omitting
# these from the allowlist did not fail loudly: ranking silently fell back to
# built-in defaults, and the Excel-path tests failed with "input file not
# found" long after the files were written.
!data/hybrid_weights.json
!data/ranking_weights.json
!data/sample_12twenty_export.xlsx
outputs/
logs/
*.log

# Machine-local Claude Code settings (paths and permissions are per-developer).
.claude/settings.local.json

# Host-local compose overrides. Deployments publish ports and add dev-only
# services (a local SMTP catcher, for example) here so the committed compose
# file keeps publishing nothing by default.
docker-compose.override.yml

# Per-developer agent tooling state. Committed once by accident; the skills it
# stored referenced throwaway root-level fetch scripts that no longer exist.
.qwen/
