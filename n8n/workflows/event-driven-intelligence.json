    { "id": "enrich", "name": "Enrich job", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [740, 220], "parameters": { "method": "POST", "url": "={{$env.HOPE_INTERNAL_API_URL}}/batches/enrich", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.HOPE_INTERNAL_SERVICE_TOKEN}}" }, { "name": "Idempotency-Key", "value": "={{$json.body.event_id}}" }, { "name": "X-Request-ID", "value": "={{$execution.id}}" }] }, "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={\"ids\":[\"{{$json.body.aggregate_id}}\"]}" } },
